{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "anchors": {
   "type": "object"
  },
  "compromise_index": {
   "type": "integer"
  },
  "front": {
   "items": {
    "type": "object"
   },
   "minItems": 5,
   "type": "array"
  },
  "generated_at": {
   "type": "string"
  },
  "problem": {
   "type": "object"
  },
  "schema_version": {
   "const": "v1"
  },
  "spec": {
   "type": "object"
  },
  "tags": {
   "additionalProperties": {
    "pattern": "^(OBSERVED|DERIVED|PREDICTED|SIMULATED|SYNTHETIC)(/(OBSERVED|DERIVED|PREDICTED|SIMULATED|SYNTHETIC))*$",
    "type": "string"
   },
   "minProperties": 1,
   "type": "object"
  },
  "tolerance": {
   "additionalProperties": false,
   "properties": {
    "abs": {
     "type": "number"
    },
    "note": {
     "type": "string"
    },
    "rel": {
     "type": "number"
    }
   },
   "required": [
    "abs",
    "rel",
    "note"
   ],
   "type": "object"
  },
  "vectors": {
   "items": {
    "type": "object"
   },
   "minItems": 4,
   "type": "array"
  }
 },
 "required": [
  "schema_version",
  "generated_at",
  "tags",
  "spec",
  "problem",
  "anchors",
  "front",
  "compromise_index",
  "vectors",
  "tolerance"
 ],
 "title": "LP and Pareto",
 "type": "object"
}
