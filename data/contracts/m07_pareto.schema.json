{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "anchors": {
   "type": "object"
  },
  "compromise_index": {
   "type": "integer"
  },
  "front": {
   "items": {
    "additionalProperties": true,
    "properties": {
     "emissions": {
      "type": "number"
     },
     "eps": {
      "type": "number"
     },
     "lp_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "profit": {
      "type": "number"
     },
     "status": {
      "enum": [
       "Optimal"
      ]
     },
     "x": {
      "items": {
       "type": "number"
      },
      "type": "array"
     }
    },
    "required": [
     "eps",
     "profit",
     "emissions",
     "x",
     "status",
     "lp_text_sha256"
    ],
    "type": "object"
   },
   "minItems": 5,
   "type": "array"
  },
  "generated_at": {
   "type": "string"
  },
  "lp_text": {
   "additionalProperties": false,
   "properties": {
    "builder": {
     "type": "string"
    },
    "example": {
     "type": "string"
    },
    "example_point": {
     "type": "integer"
    },
    "example_sha256": {
     "pattern": "^[0-9a-f]{64}$",
     "type": "string"
    },
    "format": {
     "type": "string"
    }
   },
   "required": [
    "format",
    "builder",
    "example_point",
    "example",
    "example_sha256"
   ],
   "type": "object"
  },
  "problem": {
   "type": "object"
  },
  "schema_version": {
   "const": "v1"
  },
  "spec": {
   "type": "object"
  },
  "tags": {
   "additionalProperties": {
    "pattern": "^(OBSERVED|DERIVED|PREDICTED|SIMULATED|SYNTHETIC)(/(OBSERVED|DERIVED|PREDICTED|SIMULATED|SYNTHETIC))*$",
    "type": "string"
   },
   "minProperties": 1,
   "type": "object"
  },
  "tolerance": {
   "additionalProperties": false,
   "properties": {
    "abs": {
     "type": "number"
    },
    "note": {
     "type": "string"
    },
    "rel": {
     "type": "number"
    }
   },
   "required": [
    "abs",
    "rel",
    "note"
   ],
   "type": "object"
  },
  "vectors": {
   "items": {
    "type": "object"
   },
   "minItems": 4,
   "type": "array"
  }
 },
 "required": [
  "schema_version",
  "generated_at",
  "tags",
  "spec",
  "problem",
  "anchors",
  "front",
  "lp_text",
  "compromise_index",
  "vectors",
  "tolerance"
 ],
 "title": "LP and Pareto",
 "type": "object"
}
